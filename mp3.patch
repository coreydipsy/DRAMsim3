+double SimpleStats::RankBackgroundEnergy(const int rank) const{
+    return vec_doubles_.at("act_stb_energy")[rank] +
+           vec_doubles_.at("pre_stb_energy")[rank] +
+           vec_doubles_.at("sref_energy")[rank];
+}
