+std::string SimpleStats::GetTextHeader(bool is_final) const {
+    std::string header =
+        "###########################################\n## Statistics of "
+        "Channel " +
+        std::to_string(channel_id_);
+    if (!is_final) {
+        header += " of epoch " + std::to_string(counters_.at("epoch_num"));
+    }
+    header += "\n###########################################\n";
+    return header;
+}
